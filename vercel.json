{
  "version": 2,
  "builds": [
    {
      "src": "public_site.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "demo_app.py",
          "app/templates/**",
          "app/static/**",
          "app/models/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "public_site.py"
    }
  ]
}
