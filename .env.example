# Server
PORT=5000
# Leave blank to generate a persistent secret in the SQLite database.
SECRET_KEY=
# Enable behind HTTPS in production.
SIAS_COOKIE_SECURE=0

# PLC mode: sim or modbus
PLC_MODE=sim
PLC_HOST=127.0.0.1
PLC_PORT=502
PLC_UNIT_ID=1

# Optional Modbus coil mapping overrides
PLC_COIL_MOTOR_RUN=0
PLC_COIL_PUMP_RUN=1
PLC_COIL_ALARM_HORN=2
PLC_COIL_ESTOP_LATCH=3
PLC_COIL_PRESSURE_RELIEF=4
PLC_COIL_LUBE_PUMP=5

# Predictive model persistence path
SIAS_MODEL_PATH=instance/predictor_model.pkl

# Authentication uses account sessions and X-CSRF-Token headers.

# Persistent SQLite registry; use a durable writable volume in production.
SIAS_DATABASE_PATH=instance/sias.sqlite3
